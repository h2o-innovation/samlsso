<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="card-title mb-0">
                <i class="fas fa-arrows-rotate me-1"></i>{{ __('samlSSO Synchronization', plugin) }}
            </h5>
        </div>

        {% if idp_name is empty %}
            <div class="alert alert-warning mb-0">
                <i class="fas fa-triangle-exclamation me-1"></i>{{ __('No samlSSO Identity Provider could be resolved for this user. Configure a matching email domain or a single active IdP.', plugin) }}
            </div>
        {% else %}
            <p class="text-muted small mb-3">
                {{ __('Identity Provider:', plugin) }} <strong>{{ idp_name }}</strong>
                {% if email is not empty %}
                    &mdash; {{ __('source email:', plugin) }} <strong>{{ email }}</strong>
                {% endif %}
            </p>

            {% if preview is empty %}
                <div class="alert alert-info mb-0">
                    <i class="fas fa-circle-info me-1"></i>{{ __('No Regex Transform is configured on the claim mappings for this Identity Provider. Add a Regex Transform to a claim mapping to enable manual synchronization.', plugin) }}
                </div>
            {% else %}
                <p class="text-muted small">
                    {{ __('The values below are derived from the source email using the configured Regex Transforms. Click "Synchronize now" to apply them to this user.', plugin) }}
                </p>
                <table class="table table-sm table-hover align-middle">
                    <thead>
                        <tr>
                            <th>{{ __('GLPI Target Field', plugin) }}</th>
                            <th>{{ __('Current value', plugin) }}</th>
                            <th>{{ __('After synchronization', plugin) }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in preview %}
                            <tr>
                                <td>{{ row.column|title }}</td>
                                <td class="text-muted" data-samlsso-current="{{ row.column }}">{{ row.current }}</td>
                                <td><strong>{{ row.derived }}</strong></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                <button type="button" class="btn btn-primary" onclick="samlssoSyncUser()">
                    <i class="fas fa-arrows-rotate me-1"></i>{{ __('Synchronize now', plugin) }}
                </button>
                <div id="samlsso_sync_result" class="mt-3"></div>
            {% endif %}
        {% endif %}
    </div>
</div>

<script>
    function samlssoSyncUser() {
        const resultBox = document.getElementById('samlsso_sync_result');
        const metaToken = document.querySelector('meta[property="glpi:csrf_token"]');
        const token = metaToken ? metaToken.getAttribute('content') : '';

        const params = new URLSearchParams();
        params.append('users_id', String({{ user_id }}));

        if (resultBox) {
            resultBox.innerHTML = '<div class="text-muted small"><i class="fas fa-spinner fa-spin"></i> ' + {{ __('Processing…', plugin)|json_encode|raw }} + '</div>';
        }

        fetch({{ sync_url|json_encode|raw }}, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'X-Glpi-Csrf-Token': token,
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: params.toString()
        })
        .then(function (response) {
            return response.text().then(function (text) {
                let data = null;
                try { data = JSON.parse(text); } catch (e) { data = null; }
                return { status: response.status, data: data };
            });
        })
        .then(function (res) {
            if (!resultBox) { return; }
            if (!res.data) {
                const tpl = {{ __('Request failed (HTTP %s). Check the GLPI logs.', plugin)|json_encode|raw }};
                resultBox.innerHTML = '<div class="alert alert-danger py-2 px-3 mb-0 small">' + tpl.replace('%s', String(res.status)) + '</div>';
                return;
            }
            const data = res.data;
            const ok = !!data.success;
            const cls = ok ? 'alert-success' : 'alert-danger';
            const msg = (data && data.message) ? data.message : {{ __('Unknown error', plugin)|json_encode|raw }};
            resultBox.innerHTML = '<div class="alert ' + cls + ' py-2 px-3 mb-0 small">' + msg + '</div>';

            if (ok && data.applied) {
                Object.keys(data.applied).forEach(function (column) {
                    const cell = document.querySelector('[data-samlsso-current="' + column + '"]');
                    if (cell) {
                        cell.textContent = data.applied[column];
                    }
                });
            }
        })
        .catch(function () {
            if (resultBox) {
                resultBox.innerHTML = '<div class="alert alert-danger py-2 px-3 mb-0 small">' + {{ __('Request failed.', plugin)|json_encode|raw }} + '</div>';
            }
        });
    }
</script>
